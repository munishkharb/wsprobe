[0.5, "o", "\u001b[3J\u001b[H\u001b[2J"]
[2.4, "o", "\u001b[1;36m wsprobe \u2014 a WebSocket security review toolkit \u001b[0m\r\n Driving its own authenticated socket against a synthetic vulnerable target.\r\n"]
[2.9, "o", "\r\n\u001b[1;32m$\u001b[0m uv run wsprobe validate /tmp/wsprobe-demo.yaml\r\n"]
[3.4, "o", "ok: profile 'demo-target' with 1 channel(s): ['default']\r\n"]
[3.9, "o", "\r\n\u001b[1;32m$\u001b[0m uv run wsprobe matrix /tmp/wsprobe-demo.yaml --expected-identity alice --foreign-identity bob\r\n"]
[4.4, "o", "unauth-upgrade             observed=upgraded-without-auth              [insecure-shape] {'upgraded': True, 'error': None}\r\nexpired-token              observed=not-supplied                       [inconclusive] {'note': 'operator did not supply a token'}\r\nforeign-token              observed=not-supplied                       [inconclusive] {'note': 'operator did not supply a token'}\r\norigin-stripped            observed=upgraded-untrusted-origin          [insecure-shape] {'origin': None, 'upgraded': True}\r\norigin-null                observed=upgraded-untrusted-origin          [insecure-shape] {'origin': 'null', 'upgraded': True}\r\norigin-sibling             observed=upgraded-untrusted-origin          [insecure-shape] {'origin': 'https://evil.127.0.0.1', 'upgraded': True}\r\norigin-bypass              observed=upgraded-untrusted-origin          [insecure-shape] {'origin': 'https://127.0.0.1.attacker.test', 'upgraded': True}\r\norigin-bypass              observed=upgraded-untrusted-origin          [insecure-shape] {'or"]
[4.9, "o", "igin': 'https://attacker-127.0.0.1', 'upgraded': True}\r\norigin-bypass              observed=upgraded-untrusted-origin          [insecure-shape] {'origin': 'https://127.0.0.1evil.test', 'upgraded': True}\r\n"]
[5.4, "o", "no-auth-control-frame      observed=acted-on-unauthenticated           [insecure-shape] {'reply': {'type': 'subscribed', 'topic': 'admin', 'cid': 1}}\r\ncross-user-handshake       observed=bound-url-identity                 [insecure-shape] {'token_identity': 'alice', 'url_identity': 'bob', 'server_bound': 'bob'}\r\n"]
[5.9, "o", "\r\n\u001b[1;32m$\u001b[0m printf '%s' \"$(uv run python -c 'from tests.fixture import mint_token;print(mint_token(\"alice\"))')\" > /tmp/a.tok\r\n"]
[6.4, "o", "\r\n\u001b[1;32m$\u001b[0m printf '%s' \"$(uv run python -c 'from tests.fixture import mint_token;print(mint_token(\"bob\"))')\" > /tmp/b.tok\r\n"]
[6.9, "o", "\r\n\u001b[1;32m$\u001b[0m uv run wsprobe diff /tmp/wsprobe-demo.yaml --frame '{\"type\":\"read_note\",\"owner\":\"bob\"}' --token-a /tmp/a.tok --token-b /tmp/b.tok --name-a alice --name-b bob\r\n"]
[7.4, "o", "reading: same-across-identities\r\n  alice reply: {\"type\": \"note\", \"owner\": \"bob\", \"content\": \"bob private note: brokerage password hint is the dog's name\", \"cid\": 1}\r\n  bob reply: {\"type\": \"note\", \"owner\": \"bob\", \"content\": \"bob private note: brokerage password hint is the dog's name\", \"cid\": 1}\r\n"]
[7.9, "o", "\r\n\u001b[1;32m$\u001b[0m uv run wsprobe sweep /tmp/wsprobe-demo.yaml --frame '{\"type\":\"read_note\"}' --field owner --values alice,bob --token-file /tmp/a.tok\r\n"]
[8.4, "o", "field=owner distinct_replies=2\r\n  owner='alice' -> {\"type\": \"note\", \"owner\": \"alice\", \"content\": \"alice private note: meeting at the old pier, code 4471\", \"cid\": 1}\r\n  owner='bob' -> {\"type\": \"note\", \"owner\": \"bob\", \"content\": \"bob private note: brokerage password hint is the dog's name\", \"cid\": 2}\r\n"]
[10.3, "o", "\r\n\u001b[1;36m Observations, never verdicts. Reproduce before you report. \u001b[0m\r\n"]
