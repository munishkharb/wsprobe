{
  "$defs": {
    "Auth": {
      "additionalProperties": false,
      "description": "How a valid token is acquired, placed, and kept fresh.\n\nThe refresh policy is load-bearing: many targets mint a single-use token\nper connection, so re-authenticating mid-run revokes the token a live\nsocket is holding. per-dial mints one token per new dial; reuse harvests\none and holds it; ttl caches until an age limit.",
      "properties": {
        "command": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "http": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpLogin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "login": {
          "$ref": "#/$defs/LoginStep",
          "default": "none"
        },
        "login_frame": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Template for a login-frame handshake. The token is placed at token_param; any '\u00a7token\u00a7' string in the template is also replaced. When unset, login-frame carriage sends {type_field: 'login', token_param: <token>}.",
          "title": "Login Frame"
        },
        "refresh": {
          "$ref": "#/$defs/RefreshPolicy",
          "default": "per-dial"
        },
        "token_extract": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dot path into a login response JSON body, e.g. data.token.",
          "title": "Token Extract"
        },
        "token_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token File"
        },
        "token_location": {
          "$ref": "#/$defs/TokenLocation",
          "default": "query"
        },
        "token_param": {
          "default": "token",
          "description": "Query key, header/cookie name, subprotocol prefix, or login-frame field.",
          "title": "Token Param",
          "type": "string"
        },
        "ttl_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttl Seconds"
        }
      },
      "title": "Auth",
      "type": "object"
    },
    "Channel": {
      "additionalProperties": false,
      "description": "One authoritative socket. A target that runs several distinct sockets\ndeclares one channel each.",
      "properties": {
        "auth": {
          "$ref": "#/$defs/Auth"
        },
        "handshake": {
          "$ref": "#/$defs/Handshake"
        },
        "heartbeat": {
          "$ref": "#/$defs/Heartbeat"
        },
        "messages": {
          "$ref": "#/$defs/MessageMap"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "probes": {
          "$ref": "#/$defs/Probes"
        }
      },
      "required": [
        "name",
        "handshake"
      ],
      "title": "Channel",
      "type": "object"
    },
    "Correlation": {
      "description": "How a reply is paired to its request.\n\necho: the server echoes the correlation key(s) back on the reply (the\ndefault, and the only mode a correlation-id-echoing server needs).\nordered: the socket answers in order, so the next non-heartbeat frame is\nthe reply. This is what most real servers actually do. Caveat: on a channel\nthat also sends unsolicited server-initiated frames (broadcasts, fan-out,\nnotifications), an ordered reply can mispair with a push; prefer echo or ack\nwhere a correlation id exists, and keep to single-in-flight requests on a\npushy socket.\nack: the framing carries its own acknowledgement id (Socket.IO acks), so\nthe codec pairs request to reply below the message map.",
      "enum": [
        "echo",
        "ordered",
        "ack"
      ],
      "title": "Correlation",
      "type": "string"
    },
    "Framing": {
      "enum": [
        "json",
        "text",
        "socketio",
        "length-prefixed",
        "binary"
      ],
      "title": "Framing",
      "type": "string"
    },
    "Handshake": {
      "additionalProperties": false,
      "description": "How to open the socket. Where the token goes is on Auth, since the\nengine has to fetch a token before it can place it here.",
      "properties": {
        "framing": {
          "$ref": "#/$defs/Framing",
          "default": "json"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "query": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Query",
          "type": "object"
        },
        "subprotocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subprotocol"
        },
        "url": {
          "description": "Upgrade URL, ws:// or wss://.",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "Handshake",
      "type": "object"
    },
    "Heartbeat": {
      "additionalProperties": false,
      "description": "The keepalive pattern to drop, so correlation and discovery stay\nreadable on a busy socket.",
      "properties": {
        "payloads": {
          "items": {
            "type": "string"
          },
          "title": "Payloads",
          "type": "array"
        },
        "types": {
          "items": {
            "type": "string"
          },
          "title": "Types",
          "type": "array"
        }
      },
      "title": "Heartbeat",
      "type": "object"
    },
    "HttpLogin": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "additionalProperties": true,
          "title": "Body",
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "method": {
          "default": "POST",
          "title": "Method",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "HttpLogin",
      "type": "object"
    },
    "LoginStep": {
      "enum": [
        "none",
        "http",
        "command",
        "token-file"
      ],
      "title": "LoginStep",
      "type": "string"
    },
    "MessageMap": {
      "additionalProperties": false,
      "description": "The message vocabulary: the field that names a type, the keys that pair\na request to its reply, and optional human names for opcodes.",
      "properties": {
        "correlation": {
          "$ref": "#/$defs/Correlation",
          "default": "echo"
        },
        "correlation_keys": {
          "items": {
            "type": "string"
          },
          "title": "Correlation Keys",
          "type": "array"
        },
        "opcode_names": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Opcode Names",
          "type": "object"
        },
        "type_field": {
          "default": "type",
          "title": "Type Field",
          "type": "string"
        }
      },
      "title": "MessageMap",
      "type": "object"
    },
    "Probes": {
      "additionalProperties": false,
      "description": "Target-specific frames the handshake matrix needs, so no fixture-shaped\nframe is baked into the engine. Each is optional; a check whose probe is\nunset is reported as inconclusive instead of run against a wrong guess.",
      "properties": {
        "control_frame": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A privileged/subscribe frame to send unauthenticated, e.g. {\"type\": \"subscribe\", \"topic\": \"admin\"}. Unset skips the no-auth control check.",
          "title": "Control Frame"
        },
        "identity_field": {
          "default": "user",
          "description": "The reply field carrying the bound identity in the identity-probe reply.",
          "title": "Identity Field",
          "type": "string"
        },
        "identity_param": {
          "default": "user",
          "description": "The URL/query parameter tested for identity override in the cross-user-handshake check.",
          "title": "Identity Param",
          "type": "string"
        },
        "identity_probe": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The frame that asks the server who it thinks you are, e.g. {\"type\": \"whoami\"}. Unset skips the cross-user-handshake check.",
          "title": "Identity Probe"
        }
      },
      "title": "Probes",
      "type": "object"
    },
    "RefreshPolicy": {
      "enum": [
        "per-dial",
        "reuse",
        "ttl"
      ],
      "title": "RefreshPolicy",
      "type": "string"
    },
    "TokenLocation": {
      "enum": [
        "query",
        "header",
        "subprotocol",
        "cookie",
        "login-frame"
      ],
      "title": "TokenLocation",
      "type": "string"
    }
  },
  "$id": "https://wsprobe.example.test/schemas/profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A portable, reusable description of one target's WebSocket surface.",
  "properties": {
    "channels": {
      "items": {
        "$ref": "#/$defs/Channel"
      },
      "minItems": 1,
      "title": "Channels",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    }
  },
  "required": [
    "name",
    "channels"
  ],
  "title": "wsprobe profile",
  "type": "object"
}
